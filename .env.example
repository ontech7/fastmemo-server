# FastMemo Server settings. Copy this file to .env (cp .env.example .env) and fill it in.

# The key your devices use to connect (FastMemo > Settings > Cloud Sync > FastMemo Server). At least 16 characters.
# Make one with:   openssl rand -hex 24
# Left empty, the server generates one on first start and prints it (docker compose logs fastmemo).
FASTMEMO_ACCESS_KEY=

# Opens the dashboard (the server's address in a browser). Left empty, the access key opens it.
FASTMEMO_ADMIN_KEY=

# The port on this computer: the server is at http://<this computer's address>:<PORT> (the web app needs HTTPS in front of it).
# With Docker, 127.0.0.1:8787 keeps it off your network (when Tailscale or a proxy on this computer serves it).
PORT=8787

# Your time zone: the dashboard counts the operations per day in it.
TZ=Europe/Rome

# How many devices can connect (each phone, PC, browser is one).
MAX_DEVICES=10

# The largest note, in MB (pictures in a note make it big).
MAX_NOTE_MB=5

# Behind a reverse proxy (Tailscale Serve, Caddy, nginx, Traefik, Coolify): set it to true, so the logs and the wrong-key
# limit see the real address of who's connecting.
TRUST_PROXY=false

# debug, info, warn or error.
LOG_LEVEL=info

# Only with docker-compose.postgres.yml: the database password (letters and digits only, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Only with docker-compose.caddy.yml: your domain (it must already point to this server), e.g. notes.example.com.
DOMAIN=
