# FastMemo Server settings. Copy this file to .env (cp .env.example .env) and fill it in.

# The key your devices use to connect (FastMemo > Settings > Cloud Sync > FastMemo Server). At least 16 characters.
# Required: the server doesn't start without it, and never prints it. Make one with:
#   openssl rand -hex 24
#   or, with Docker only: docker run --rm node:24-alpine node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
FASTMEMO_ACCESS_KEY=

# Opens the dashboard (the server's address in a browser). Left empty, the access key opens it.
FASTMEMO_ADMIN_KEY=

# The port on this computer: the server is at http://<this computer's address>:<PORT> (the web app needs HTTPS in front of it).
# With Docker, 127.0.0.1:8787 keeps it off your network (when Tailscale or a proxy on this computer serves it).
PORT=8787

# Your time zone: the dashboard counts the operations per day in it.
TZ=Europe/Rome

# How many devices can connect (each phone, PC, browser is one).
MAX_DEVICES=10

# The largest note, in MB (pictures in a note make it big). Counted encrypted: a note's text can be about 3/4 of it.
# A note over it isn't synced: the app keeps it offline, on the device it's on.
MAX_NOTE_MB=5

# The image the compose files run. Left empty: the newest 1.x (ghcr.io/ontech7/fastmemo-server:1). The updater sets it to one
# exact version. To move by hand: docker compose pull && docker compose up -d. A new major version (2.0): read its notes,
# then set this. Not used by docker-compose.coolify.yml.
FASTMEMO_IMAGE=

# Behind a reverse proxy (Tailscale Serve, Caddy, Cloudflare Tunnel, nginx, Traefik, Coolify): set it to true, so the logs and the wrong-key
# limit see the real address of who's connecting.
TRUST_PROXY=false

# debug, info, warn or error.
LOG_LEVEL=info

# Looks on GitHub every 6 hours for a newer release (the dashboard and the app then say so). Nothing but that request leaves
# the server. on or off.
UPDATE_CHECK=on

# Where the updater is asked to install a release, and where it reports back. Leave empty: set by contrib/updater/compose.updater.yaml.
UPDATE_REQUEST_DIR=
UPDATE_STATUS_DIR=

# Only with docker-compose.postgres.yml: the database password (letters and digits only, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=

# Only with docker-compose.caddy.yml: your domain (it must already point to this server), e.g. notes.example.com.
DOMAIN=

# Only with docker-compose.cloudflare.yml: the tunnel's token (Cloudflare dashboard > Networking > Tunnels). Keep it private.
CLOUDFLARE_TUNNEL_TOKEN=

# Only with docker-compose.tailscale.yml: an auth key (Tailscale admin > Settings > Keys). Left empty, sign in with the link in
# docker compose -f docker-compose.tailscale.yml logs tailscale.
TS_AUTHKEY=
# Only with docker-compose.tailscale.yml: the address is https://<TS_HOSTNAME>.<your-tailnet>.ts.net (fastmemo when empty).
TS_HOSTNAME=
