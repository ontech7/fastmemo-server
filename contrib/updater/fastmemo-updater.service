[Unit]
Description=fastmemo-server: install a newer release requested in the dashboard
Requires=docker.service
After=docker.service
# It spaces its own runs out (COOLDOWN), so a flood of requests never parks the path unit in "failed".
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /usr/local/lib/fastmemo/fastmemo-updater.py
# The worst case of every step, rollback included. On timeout it gets SIGTERM and rolls back within TimeoutStopSec;
# KillMode=mixed leaves the docker commands of that rollback alone until then.
TimeoutStartSec=40min
TimeoutStopSec=10min
KillMode=mixed
# Optional: GH_TOKEN=<a token with no scopes> lets it verify the build provenance with the GitHub CLI.
EnvironmentFile=-/etc/fastmemo/updater.secret
Environment=DOCKER_CONFIG=/var/lib/fastmemo-update/docker
Environment=HOME=/var/lib/fastmemo-update/gh GH_CONFIG_DIR=/var/lib/fastmemo-update/gh
# Root only because it drives Docker, and the Docker socket is root anyway: this sandbox limits mistakes, not an
# attacker. It writes its own folders, the data volume (to copy the database and put it back) and your checkout's .env
# (atomically, so it needs the folder): the install steps open the checkout with a drop-in,
# /etc/systemd/system/fastmemo-updater.service.d/checkout.conf, holding ReadWritePaths=<your checkout>. If Docker keeps
# its data elsewhere than /var/lib/docker (data-root), add that folder's volumes/ the same way.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=-/etc/fastmemo -/var/lib/fastmemo-update -/var/lib/docker/volumes -/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
# Also once at boot: a switch a power cut interrupted is undone before anyone notices.
WantedBy=multi-user.target
