# /etc/fastmemo/updater.env — owned by root, mode 0644 (the updater refuses it otherwise)
# The GitHub repository whose releases are installed, and the image it publishes (no tag)
REPO=ontech7/fastmemo-server
IMAGE=ghcr.io/ontech7/fastmemo-server
# Where the releases are looked up
GITHUB_API=https://api.github.com
# Your fastmemo-server checkout, where you run docker compose (required)
COMPOSE_DIR=/home/pi/fastmemo-server
# The compose files you start it with, relative to COMPOSE_DIR, separated by ":" (like Docker's COMPOSE_FILE)
COMPOSE_FILE=docker-compose.yml:contrib/updater/compose.updater.yaml
# The .env used with them (empty: COMPOSE_DIR/.env); FASTMEMO_IMAGE is the only line the updater changes in it
ENV_FILE=
# The server's service in the compose files
SERVICE=fastmemo
# Mounted in the server: request read-write, status read-only
REQUEST_DIR=/var/lib/fastmemo-update/request
STATUS_DIR=/var/lib/fastmemo-update/status
# Database copies taken before every switch (the last 3 are kept)
BACKUP_DIR=/var/lib/fastmemo-update/backup
# Seconds the new version has to become healthy before the previous one comes back
HEALTH_TIMEOUT=120
# Seconds between two runs, so a flood of requests cannot keep Docker and GitHub busy
COOLDOWN=15
# Build provenance, checked with the GitHub CLI (gh) against the exact digest that will run. It needs a token:
# GH_TOKEN=<a token with no scopes> in /etc/fastmemo/updater.secret (root, 0600).
# auto: verify when gh and a token are there; required: fail without them; off: never
VERIFY_PROVENANCE=auto
# The workflow that must have built and signed the image
SIGNER_WORKFLOW=.github/workflows/release.yml
