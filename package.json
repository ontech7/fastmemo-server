{
  "name": "fastmemo-server",
  "version": "1.1.0",
  "description": "Self-hosted sync server for FastMemo: end-to-end encrypted notes, live sync between devices, ops dashboard.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"public/**/*.{js,css,html}\" \"*.md\" \"docs/**/*.md\"",
    "test:pg": "node --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  }
}
